<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %level %logger -- %msg%n</pattern>
    </encoder>
  </appender>

  <!-- The SDK logs client errors at DEBUG; tests assert what reaches that level. -->
  <logger name="io.codehunters.web.errors" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
